<body>
<script>
    /*<![CDATA[*/
    const apiList = [{"seqApi":286,"nmApi":"\uB2E8\uAE30\uC608\uBCF4","dscApi":null,"dvApiGrphc":null},{"seqApi":287,"nmApi":"\uC911\uAE30\uC608\uBCF4","dscApi":null,"dvApiGrphc":null},{"seqApi":288,"nmApi":"\uAE30\uC0C1\uD2B9\uBCF4","dscApi":null,"dvApiGrphc":null},{"seqApi":289,"nmApi":"\uC601\uD5A5\uC608\uBCF4","dscApi":null,"dvApiGrphc":null},{"seqApi":321,"nmApi":"\uC608\u00B7\uD2B9\uBCF4 \uAD6C\uC5ED\uC815\uBCF4","dscApi":null,"dvApiGrphc":null}];
    /*]]>*/

    const onClickGenerateUrl = (seqApi) => {
        var popupWidth = 800;
        var popupHeight = 450;

        var popupX = window.screenX + (window.screen.width / 4 ) - (popupWidth / 2);
        var popupY = window.screenY + (window.screen.height / 2 ) - (popupHeight / 2);

        window.open(`/generateUrl.do?seqApi=${seqApi}`, '',
            'status=no, height=' + popupHeight + ', width=' + popupWidth + ', left=' + popupX
            + ', top='
            + popupY);
    }

    const openSampleCode = (seqApi) => {
        var popupWidth = 900;
        var popupHeight = 600;

        var popupX = window.screenX + (window.screen.width / 4 ) - (popupWidth / 2);
        var popupY = window.screenY + (window.screen.height / 2 ) - (popupHeight / 2);

        window.open(`/sampleCode.do?seqApi=${seqApi}`, '',
            'status=no, height=' + popupHeight + ', width=' + popupWidth + ', left=' + popupX
            + ', top='
            + popupY);
    }

    const openAPIUrl = (seqApi, seqApiSub) => {
        var popupWidth = 1200;
        var popupHeight = 500;

        var popupX = window.screenX + (window.screen.width / 4 ) - (popupWidth / 2);
        var popupY = window.screenY + (window.screen.height / 2 ) - (popupHeight / 2);

        window.open(`/generateAPIUrl.do?seqApi=${seqApi}&seqApiSub=${seqApiSub}`, '',
            'status=no, height=' + popupHeight + ', width=' + popupWidth + ', left=' + popupX
            + ', top='
            + popupY);
    }

    const openAPIUse = (seqApi) => {
        var popupWidth = 800;
        var popupHeight = 600;

        var popupX = window.screenX + (window.screen.width / 2 ) - (popupWidth / 2);
        var popupY = window.screenY + (window.screen.height /2 ) - (popupHeight / 2);

        window.open(`/APIUse.do?seqApi=${seqApi}`, '',
            'status=no, height=' + popupHeight + ', width=' + popupWidth + ', left=' + popupX
            + ', top='
            + popupY);
    }

    const onClickLoginBtn = () => {
        const loginBtn = $('body', window.parent.document).find('.btn-login');
        if (loginBtn.length > 0) {
            loginBtn[0].click()
        }
    }

    const copySampleUrl = event => {
        const urlElement = $(event.target).parent().prev().eq(0);
        if(urlElement) {
            const copyText = urlElement.attr('href');
            const $textarea = document.createElement("textarea");

            // body 요소에 존재해야 복사가 진행됨
            document.body.appendChild($textarea);

            // 복사할 특정 텍스트를 임시의 textarea에 넣어주고 모두 셀렉션 상태
            $textarea.value = copyText;
            $textarea.select();

            // 복사 후 textarea 지우기
            document.execCommand('copy');
            document.body.removeChild($textarea);
            fnAlert('URL이 복사되었습니다.')
        }
    }
    
    $(document).ready(() => {

	    var apiMovChk = $('input[name=apiMovChk]').val();
	    
	    if(apiMovChk == "Y"){
		    
		    //h3 태그를 찾을 이름
		    var targetHeading = $('input[name=apiMov]').val();
		    // 모든 h3태그 가져오기
		    var headings = document.getElementsByTagName('h3');
	    
	    	//alert(targetHeading);
		    
		    //해당 이름과 일치하는 h3태그 찾기
		    var targetHeadingElement;
		    
		    for(var i=0; i < headings.length; i++){
		    	if(headings[i].innerText.includes(targetHeading)){
		    		targetHeadingElement = headings[i];
		    		break;
		    	}    	
		    }
		    
		    if(targetHeadingElement){
		    	targetHeadingElement.scrollIntoView({ behavior: 'auto',block:'start',inline:'center'});    	
		    }
		    

		    
		    //li 태그를 찾을 이름
		    var targetHeadingLi = "menuLi" + $('input[name=seqApi]').val();
		    // 모든 부모의 li태그 가져오기
		    var headingsLi = parent.document.getElementsByTagName('li');
	    
	    	//alert(targetHeading);
		    
		    //해당 이름과 일치하는 h3태그 찾기
		    var targetHeadingElementLi;
		    
		    for(var i=0; i < headingsLi.length; i++){
		    	if(headingsLi[i].id == targetHeadingLi){
		    		targetHeadingElementLi = headingsLi[i];
		    		break;
		    	}    	
		    }
		    
		    if(targetHeadingElementLi){
		    	targetHeadingElementLi.classList.toggle('on');    	
		    }
	    }
    });
    //
    // 접히는 코드 삭제
    // $(document).ready(() => {
    //     $('.collapsible').css({
    //         cursor: 'pointer',
    //     })
    //     $('.collapsible').next().hide();
    //     $('.collapsible').hover(function() {
    //         $(this).css('color', '#ccc');
    //     },function() {
    //         $(this).css('color', '#222');
    //     })
    //     $('.collapsible').click((event) => {
    //         if($(event.target).next().is(':visible')) {
    //             // collapsible
    //             $(event.target).text($(event.target).text().replaceAll('>', '<'))
    //             $(event.target).next().hide()
    //         } else {
    //             // expand
    //             $(event.target).text($(event.target).text().replaceAll('<', '>'))
    //             $(event.target).next().show()
    //         }
    //     })
    // })
</script>
<div class="wrapper">
    <div class="container">
        <div class="contents" >
            <div class="title-wrap">
                <div class="title">
                    <h2>예특보</h2>
                </div>
            </div>
            <input type ="hidden" id="seqApi" name="seqApi" value="10"/>
            <input type ="hidden" id="apiMov" name="apiMov" value="4. 동네예보(초단기실황·초단기예보·단기예보) 조회"/>
            <input type ="hidden" id="apiMovChk" name="apiMovChk"  value="Y"/>
            
            <p class="tit-cont01">초단기, 단기, 중기예보의 기온, 바람, 강수량 등 데이터를 제공하며, 폭염, 한파, 호우 등 10종의 기상특보(주의보, 경보) 데이터를 제공합니다.</p>
            <div class="tab_list type">
                <ul>
                    
                            <li onclick="location.href=&#39;/apiList.do?seqApi=10&amp;seqApiSub=286&#39;" class="active">
                                <a>단기예보</a>
                            </li>
                    
                            <li onclick="location.href=&#39;/apiList.do?seqApi=10&amp;seqApiSub=287&#39;">
                                <a>중기예보</a>
                            </li>
                    
                            <li onclick="location.href=&#39;/apiList.do?seqApi=10&amp;seqApiSub=288&#39;">
                                <a>기상특보</a>
                            </li>
                    
                            <li onclick="location.href=&#39;/apiList.do?seqApi=10&amp;seqApiSub=289&#39;">
                                <a>영향예보</a>
                            </li>
                    
                            <li onclick="location.href=&#39;/apiList.do?seqApi=10&amp;seqApiSub=321&#39;">
                                <a>예·특보 구역정보</a>
                            </li>
                    
                </ul>
            </div>
            <!-- API desc -->
            
                <div class="Tbl-wrap mt40">
                    <table class="Tbl">
                        <caption>api 상세</caption>
                        <colgroup><col width="10%"><col width="90%"></colgroup>
                        <tbody>
                        
                            <tr>
                                <th>개요</th>
                                <td><p class="txt">단기예보란 예보기간과 구역을 시 · 공간적으로 세분화하여 발표하는 예보입니다. 지역별, 시간별 차이로 인한 수요자의 불편을 최소화하기 위해 전국을 5km * 5km 간격의 격자(동서 149(745km) × 남북 253(1.265km)), 총 37,697개로 나누어, 3시간 마다 읍, 면, 동 단위의 행정구역 중심으로 상세한 날씨를 제공합니다. </p></td>
                            </tr>
                        
                            <tr>
                                <th>요 소</th>
                                <td><p class="txt">3시간 기온, 낮 최고기온, 아침 최저기온, 풍향, 풍속, 동서바람성분, 남북바람성분,  하늘상태, 강수형태, 강수확률, 6시간 강수량, 6시간 신적설, 습도, 파고</p></td>
                            </tr>
                        
                            <tr>
                                <th>지 점</th>
                                <td><p class="txt">동사무소를 중심으로 하는 행정구역</p></td>
                            </tr>
                        
                            <tr>
                                <th>보유기간</th>
                                <td><p class="txt">2008년 10월 30일 17:00KST(시행일 기준) ~ 현재</p></td>
                            </tr>
                        
                            <tr>
                                <th>생산주기</th>
                                <td><p class="txt">2시부터 3시간 간격(일 8회)</p></td>
                            </tr>
                        
                        </tbody>
                    </table>
                </div>
            
            <div class="btn-wrap">
                <button class="btn btn_00" onclick="openAPIUrl(10, 286)">URL 발행</button>
                <button class="btn btn_00" onclick="openSampleCode(10)">API 샘플코드</button>
            </div>
            <!-- API sub list -->
            
