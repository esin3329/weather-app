  <script>
    $(function() {
      if($('.wrapper', top.document).find('#confirmPopup').length == 0){
        $('.wrapper', top.document).append($(html.confirm));
      }
      if($('.wrapper', top.document).find('#alertPopup').length == 0){
        $('.wrapper', top.document).append($(html.alert));
      }
    });
